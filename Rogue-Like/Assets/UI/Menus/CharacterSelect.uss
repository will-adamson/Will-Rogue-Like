.root {
    width: 100%;
    height: 100%;
    background-color: #12131e;
    align-items: center;
    justify-content: center;
    padding: 32px;
}

.title {
    font-size: 28px;
    color: #c8d8f0;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    letter-spacing: 6px;
    margin-bottom: 8px;
}

.divider {
    width: 100%;
    height: 1px;
    background-color: #3a4a6b;
    margin-top: 8px;
    margin-bottom: 20px;
}

.card-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 16px;
}

.card {
    width: 220px;
    margin-left: 10px;
    margin-right: 10px;
    padding: 20px;
    background-color: #1a1d2e;
    border-color: #3a4a6b;
    border-width: 1px;
    border-radius: 2px;
    align-items: center;
    cursor: link;
    transition-duration: 0.15s;
}

.card:hover {
    background-color: #1e2440;
    border-color: #6a7aaa;
}

.card-selected {
    background-color: #1e2440;
    border-color: #8a9ab8;
    border-width: 2px;
}

.card-icon {
    font-size: 32px;
    -unity-text-align: upper-center;
    margin-bottom: 10px;
    color: #8a9ab8;
}

.card-name {
    font-size: 16px;
    color: #c8d8f0;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: upper-center;
    margin-bottom: 10px;
}

.card-desc {
    font-size: 11px;
    color: #6a7aaa;
    -unity-text-align: upper-center;
    white-space: normal;
    margin-bottom: 14px;
}

.card-stats {
    width: 100%;
    flex-direction: column;
}

.stat-label {
    font-size: 10px;
    color: #3a4a6b;
    letter-spacing: 2px;
    margin-bottom: 2px;
}

.stat-val {
    font-size: 11px;
    letter-spacing: 2px;
    margin-bottom: 6px;
}

.stat-high { color: #8a9ab8; }
.stat-mid  { color: #4a5a7a; }
.stat-low  { color: #2e3650; }

.info-bar {
    width: 100%;
    padding: 12px 20px;
    background-color: #1a1d2e;
    border-color: #3a4a6b;
    border-width: 1px;
    border-radius: 2px;
    margin-bottom: 16px;
    align-items: center;
}

.info-text {
    font-size: 12px;
    color: #6a7aaa;
    letter-spacing: 1px;
    -unity-text-align: upper-center;
}

.button-row {
    flex-direction: row;
    justify-content: center;
    width: 100%;
}

.btn {
    width: 180px;
    height: 48px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: #1a1d2e;
    border-color: #3a4a6b;
    border-width: 1px;
    border-radius: 2px;
    color: #8a9ab8;
    font-size: 13px;
    letter-spacing: 3px;
    transition-duration: 0.15s;
    cursor: link;
}

.btn:hover {
    background-color: #2a3a5a;
    border-color: #8a9ab8;
    color: #c8d8f0;
}

.btn:active { scale: 0.98; }

.btn-primary {
    border-color: #6a7aaa;
    color: #c8d8f0;
    background-color: #2a3a5a;
}

.btn-primary:hover {
    background-color: #3a4a6b;
    border-color: #c8d8f0;
}
