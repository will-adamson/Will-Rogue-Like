.root {
  width: 100%;
  height: 100%;
  background-color: rgba(10, 11, 20, 0.8);
  align-items: center;
  justify-content: center;
}

.pause-container {
  width: 320px;
  background-color: #1a1d2e;
  border-color: #3a4a6b;
  border-width: 1px;
  border-radius: 2px;
  padding: 32px;
  align-items: stretch;
}

.title {
  font-size: 32px;
  color: #c8d8f0;
  -unity-font-style: bold;
  -unity-text-align: upper-center;
  letter-spacing: 8px;
  margin-bottom: 8px;
}

.divider {
  height: 1px;
  background-color: #3a4a6b;
  margin-top: 8px;
  margin-bottom: 20px;
}

.divider-thin {
  height: 1px;
  background-color: #1e2236;
  margin-top: 8px;
  margin-bottom: 12px;
}

.btn {
  height: 48px;
  margin-bottom: 10px;
  background-color: #12131e;
  border-color: #3a4a6b;
  border-width: 1px;
  border-radius: 2px;
  color: #8a9ab8;
  font-size: 13px;
  letter-spacing: 3px;
  transition-duration: 0.15s;
}

.btn:hover {
  background-color: #2a3a5a;
  border-color: #8a9ab8;
  color: #c8d8f0;
}

.btn:active {
  scale: 0.98;
}

.btn-danger {
  border-color: #6b3a2a;
  color: #8b4a2a;
  margin-bottom: 0;
}

.btn-danger:hover {
  background-color: rgba(107, 58, 42, 0.3);
  border-color: #8b4a2a;
  color: #b06040;
}
