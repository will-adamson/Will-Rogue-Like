/* Colour palette — matches MainMenu.uss
   bg-dark:    #12131e
   bg-mid:     #1a1d2e
   blue-dim:   #3a4a6b
   blue-mid:   #4a5a7a
   blue-light: #6a7aaa
   blue-pale:  #8a9ab8
   blue-bright:#c8d8f0
   accent:     #8b4a2a
*/

.root {
    width: 100%;
    height: 100%;
    background-color: #12131e;
    align-items: center;
    justify-content: center;
}

.settings-container {
    width: 480px;
    align-items: stretch;
    padding: 32px;
    background-color: #1a1d2e;
    border-color: #3a4a6b;
    border-width: 1px;
    border-radius: 2px;
}

.title {
    font-size: 32px;
    color: #c8d8f0;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    letter-spacing: 8px;
    margin-bottom: 8px;
}

.divider {
    height: 1px;
    background-color: #3a4a6b;
    margin-top: 8px;
    margin-bottom: 16px;
}

.divider-thin {
    height: 1px;
    background-color: #1e2236;
    margin-top: 8px;
    margin-bottom: 16px;
}

.section-label {
    font-size: 11px;
    color: #3a4a6b;
    letter-spacing: 4px;
    margin-bottom: 12px;
}

.row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 40px;
    margin-bottom: 4px;
    padding-left: 4px;
    padding-right: 4px;
}

.row:hover {
    background-color: rgba(58, 74, 107, 0.15);
}

.row-label {
    font-size: 13px;
    color: #8a9ab8;
    letter-spacing: 1px;
    width: 160px;
    flex-shrink: 0;
}

.slider {
    flex-grow: 1;
    margin-left: 12px;
    margin-right: 8px;
}

.slider-value {
    font-size: 12px;
    color: #6a7aaa;
    width: 28px;
    -unity-text-align: middle-right;
}

/* Unity 6 toggle selectors */
.toggle {
    margin-left: 12px;
}

.toggle > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: #12131e;
    border-color: #3a4a6b;
    border-width: 1px;
    border-radius: 2px;
    width: 20px;
    height: 20px;
}

.toggle:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: #3a4a6b;
    border-color: #8a9ab8;
}

.button-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 4px;
}

.btn {
    flex: 1;
    height: 48px;
    margin-right: 8px;
    background-color: #12131e;
    border-color: #3a4a6b;
    border-width: 1px;
    border-radius: 2px;
    color: #8a9ab8;
    font-size: 13px;
    letter-spacing: 3px;
    transition-duration: 0.15s;
    cursor: link;
}

.btn:last-child {
    margin-right: 0;
}

.btn:hover {
    background-color: #2a3a5a;
    border-color: #8a9ab8;
    color: #c8d8f0;
}

.btn:active {
    scale: 0.98;
    background-color: #3a4a6b;
}

.btn-primary {
    border-color: #6a7aaa;
    color: #c8d8f0;
    background-color: #2a3a5a;
}

.btn-primary:hover {
    background-color: #3a4a6b;
    border-color: #c8d8f0;
}
