.root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: flex-end;
}

.log-container {
    width: 100%;
    height: 110px;
    background-color: rgba(10, 11, 18, 0.88);
    border-top-width: 1px;
    border-color: #2a3a5a;
    padding: 6px 10px;
    flex-shrink: 0;
}

.log-scroll {
    width: 100%;
    height: 100%;
}

.log-content {
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100%;
}

.log-line {
    font-size: 11px;
    color: #3a4a6b;
    white-space: normal;
    margin-bottom: 2px;
}

.log-line-latest  { color: #8a9ab8; }
.log-line-damage  { color: #8a4a4a; }
.log-line-good    { color: #4a8a4a; }
.log-line-gold    { color: #c8a030; }
.log-line-system  { color: #4a5a7a; -unity-font-style: italic; }
