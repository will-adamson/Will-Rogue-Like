.root {
    width: 100%;
    height: 100%;
    background-color: #1c1f2e;
    align-items: center;
    justify-content: center;
}

.settings-container {
    width: 520px;
    align-items: stretch;
    padding: 36px;
    background-color: #2a2d3e;
    border-color: #4a5070;
    border-width: 1px;
    border-radius: 6px;
}

.title {
    font-size: 30px;
    color: #f0f2ff;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    letter-spacing: 8px;
    margin-bottom: 8px;
}

.divider {
    height: 1px;
    background-color: #4a5070;
    margin-top: 8px;
    margin-bottom: 20px;
}

.divider-thin {
    height: 1px;
    background-color: #363a52;
    margin-top: 4px;
    margin-bottom: 16px;
}

.section-label {
    font-size: 10px;
    color: #7a8ab0;
    letter-spacing: 4px;
    margin-bottom: 10px;
    -unity-font-style: bold;
}

.row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 44px;
    margin-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 4px;
}

.row:hover { background-color: rgba(74, 80, 112, 0.25); }

.row-label {
    font-size: 14px;
    color: #c8cce0;
    letter-spacing: 1px;
    width: 160px;
    flex-shrink: 0;
}

.slider {
    flex-grow: 1;
    margin-left: 12px;
    margin-right: 8px;
}

.slider-value {
    font-size: 13px;
    color: #7eb4ff;
    width: 32px;
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

.toggle { margin-left: 12px; }

.toggle > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: #1c1f2e;
    border-color: #4a5070;
    border-width: 1px;
    border-radius: 3px;
    width: 22px;
    height: 22px;
}

.toggle:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: #2e4070;
    border-color: #7eb4ff;
}

.button-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}

.btn {
    flex: 1;
    height: 52px;
    margin-left: 4px;
    margin-right: 4px;
    background-color: #1c1f2e;
    border-color: #4a5070;
    border-width: 1px;
    border-radius: 4px;
    color: #c8cce0;
    font-size: 13px;
    letter-spacing: 3px;
    transition-duration: 0.12s;
}

.btn:hover {
    background-color: #363a52;
    border-color: #7eb4ff;
    color: #f0f2ff;
}

.btn:active {
    scale: 0.98;
    background-color: #404466;
}

.btn-primary {
    background-color: #2e4070;
    border-color: #7a8ab0;
    color: #aed0ff;
}

.btn-primary:hover {
    background-color: #384880;
    border-color: #7eb4ff;
    color: #f0f2ff;
}
