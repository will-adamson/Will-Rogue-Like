.root {
    width: 100%;
    height: 100%;
    background-color: #0d0d0f;
    align-items: center;
    justify-content: center;
}

.settings-container {
    width: 520px;
    align-items: stretch;
    padding: 36px;
    background-color: #16181f;
    border-color: #2e3550;
    border-width: 1px;
    border-radius: 6px;
}

.title {
    font-size: 30px;
    color: #e8eaf0;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    letter-spacing: 8px;
    margin-bottom: 8px;
}

.divider {
    height: 1px;
    background-color: #2e3550;
    margin-top: 8px;
    margin-bottom: 20px;
}

.divider-thin {
    height: 1px;
    background-color: #1a1d28;
    margin-top: 4px;
    margin-bottom: 16px;
}

.section-label {
    font-size: 10px;
    color: #4a5a8a;
    letter-spacing: 4px;
    margin-bottom: 10px;
    -unity-font-style: bold;
}

.row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 44px;
    margin-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 4px;
}

.row:hover { background-color: rgba(74, 90, 138, 0.12); }

.row-label {
    font-size: 14px;
    color: #a8b0c8;
    letter-spacing: 1px;
    width: 160px;
    flex-shrink: 0;
}

.slider {
    flex-grow: 1;
    margin-left: 12px;
    margin-right: 8px;
}

.slider-value {
    font-size: 13px;
    color: #7a9fff;
    width: 32px;
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

.toggle { margin-left: 12px; }

.toggle > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: #0d0d0f;
    border-color: #2e3550;
    border-width: 1px;
    border-radius: 3px;
    width: 22px;
    height: 22px;
}

.toggle:checked > .unity-toggle__input > .unity-toggle__checkmark {
    background-color: #1e2a50;
    border-color: #7a9fff;
}

.button-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}

.btn {
    flex: 1;
    height: 52px;
    margin-left: 4px;
    margin-right: 4px;
    background-color: #0d0d0f;
    border-color: #2e3550;
    border-width: 1px;
    border-radius: 4px;
    color: #a8b0c8;
    font-size: 13px;
    letter-spacing: 3px;
    transition-duration: 0.12s;
}

.btn:hover {
    background-color: #1e2130;
    border-color: #7a9fff;
    color: #e8eaf0;
}

.btn:active {
    scale: 0.98;
    background-color: #252840;
}

.btn-primary {
    background-color: #1e2a50;
    border-color: #4a5a8a;
    color: #a8c4ff;
}

.btn-primary:hover {
    background-color: #263260;
    border-color: #7a9fff;
    color: #e8eaf0;
}
