.root {
    width: 100%;
    height: 100%;
    background-color: rgba(10, 10, 14, 0.82);
    align-items: center;
    justify-content: center;
}

.pause-container {
    width: 340px;
    background-color: #16181f;
    border-color: #2e3550;
    border-width: 1px;
    border-radius: 6px;
    padding: 36px;
    align-items: stretch;
}

.title {
    font-size: 30px;
    color: #e8eaf0;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    letter-spacing: 8px;
    margin-bottom: 8px;
}

.divider {
    height: 1px;
    background-color: #2e3550;
    margin-top: 8px;
    margin-bottom: 24px;
}

.divider-thin {
    height: 1px;
    background-color: #1a1d28;
    margin-top: 8px;
    margin-bottom: 16px;
}

.prompt-text {
    font-size: 13px;
    color: #a8b0c8;
    white-space: normal;
    -unity-text-align: upper-center;
    margin-bottom: 8px;
}

.btn {
    height: 52px;
    margin-bottom: 10px;
    background-color: #0d0d0f;
    border-color: #2e3550;
    border-width: 1px;
    border-radius: 4px;
    color: #a8b0c8;
    font-size: 13px;
    letter-spacing: 3px;
    transition-duration: 0.12s;
}

.btn:hover {
    background-color: #1e2130;
    border-color: #7a9fff;
    color: #e8eaf0;
}

.btn:active { scale: 0.98; }

.btn-danger {
    border-color: #7a3030;
    color: #c08080;
    margin-bottom: 0;
}

.btn-danger:hover {
    background-color: #2a1818;
    border-color: #c05050;
    color: #e8a0a0;
}
