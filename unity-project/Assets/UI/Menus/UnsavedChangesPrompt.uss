.root {
    width: 100%;
    height: 100%;
    background-color: rgba(20, 22, 34, 0.85);
    align-items: center;
    justify-content: center;
}

.prompt-container {
    width: 460px;
    background-color: #2a2d3e;
    border-color: #4a5070;
    border-width: 1px;
    border-radius: 6px;
    padding: 36px;
    align-items: stretch;
}

.title {
    font-size: 22px;
    color: #f0f2ff;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    letter-spacing: 6px;
    margin-bottom: 8px;
}

.divider {
    height: 1px;
    background-color: #4a5070;
    margin-top: 8px;
    margin-bottom: 20px;
}

.divider-thin {
    height: 1px;
    background-color: #363a52;
    margin-top: 4px;
    margin-bottom: 16px;
}

.prompt-text {
    font-size: 14px;
    color: #c8cce0;
    white-space: normal;
    -unity-text-align: upper-center;
    margin-bottom: 8px;
    letter-spacing: 1px;
}

.btn {
    height: 52px;
    margin-bottom: 10px;
    background-color: #1c1f2e;
    border-color: #4a5070;
    border-width: 1px;
    border-radius: 4px;
    color: #c8cce0;
    font-size: 13px;
    letter-spacing: 3px;
    transition-duration: 0.12s;
}

.btn:hover {
    background-color: #363a52;
    border-color: #7eb4ff;
    color: #f0f2ff;
}

.btn:active { scale: 0.98; }

.btn-danger {
    border-color: #905050;
    color: #e09090;
    margin-bottom: 0;
}

.btn-danger:hover {
    background-color: #3a2828;
    border-color: #e06060;
    color: #ffaaaa;
}
