.root {
    width: 100%;
    height: 100%;
    background-color: #12131e;
    align-items: center;
    justify-content: center;
    padding: 32px;
}

.title {
    font-size: 28px;
    color: #c8d8f0;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    letter-spacing: 6px;
    margin-bottom: 8px;
}

.divider {
    width: 100%;
    height: 1px;
    background-color: #3a4a6b;
    margin-top: 8px;
    margin-bottom: 20px;
}

.card-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 16px;
}

.card {
    width: 220px;
    margin-left: 10px;
    margin-right: 10px;
    padding: 20px;
    background-color: #1a1d2e;
    border-color: #3a4a6b;
    border-width: 1px;
    border-radius: 2px;
    align-items: center;
    transition-duration: 0.15s;
}

.card:hover {
    background-color: #1e2440;
    border-color: #6a7aaa;
}

.card-selected {
    background-color: #1e2440;
    border-color: #8a9ab8;
    border-width: 2px;
}

.card-sprite {
    width: 80px;
    height: 80px;
    margin-bottom: 10px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
}

.card-name {
    font-size: 16px;
    color: #c8d8f0;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: upper-center;
    margin-bottom: 10px;
}

.card-desc {
    font-size: 11px;
    color: #6a7aaa;
    -unity-text-align: upper-center;
    white-space: normal;
    margin-bottom: 14px;
}

.card-stats {
    width: 100%;
    flex-direction: column;
}

.stat-label {
    font-size: 10px;
    color: #3a4a6b;
    letter-spacing: 2px;
    width: 30px;
    flex-shrink: 0;
    margin-bottom: 2px;
}

.stat-track {
    flex-grow: 1;
    height: 5px;
    background-color: #12131e;
    border-color: #2a3a5a;
    border-width: 1px;
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 6px;
}

.stat-fill {
    height: 100%;
    width: 0%;
    border-radius: 2px;
}

.stat-fill-hp  { background-color: #6b2a2a; }
.stat-fill-atk { background-color: #6b4a2a; }
.stat-fill-spd { background-color: #2a5a4a; }

.card-passive {
    font-size: 10px;
    color: #3a4a6b;
    -unity-text-align: upper-center;
    white-space: normal;
    margin-top: 8px;
}

.info-bar {
    width: 100%;
    padding: 12px 20px;
    background-color: #1a1d2e;
    border-color: #3a4a6b;
    border-width: 1px;
    border-radius: 2px;
    margin-bottom: 16px;
    align-items: center;
}

.info-text {
    font-size: 12px;
    color: #6a7aaa;
    letter-spacing: 1px;
    -unity-text-align: upper-center;
}

.button-row {
    flex-direction: row;
    justify-content: center;
    width: 100%;
}

.btn {
    width: 180px;
    height: 48px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: #1a1d2e;
    border-color: #3a4a6b;
    border-width: 1px;
    border-radius: 2px;
    color: #8a9ab8;
    font-size: 13px;
    letter-spacing: 3px;
    transition-duration: 0.15s;
}

.btn:hover {
    background-color: #2a3a5a;
    border-color: #8a9ab8;
    color: #c8d8f0;
}

.btn:active { scale: 0.98; }

.btn-primary {
    border-color: #6a7aaa;
    color: #c8d8f0;
    background-color: #2a3a5a;
}

.btn-primary:hover {
    background-color: #3a4a6b;
    border-color: #c8d8f0;
}
