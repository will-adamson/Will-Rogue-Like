.root {
    width: 100%;
    height: 100%;
    background-color: #0d0d0f;
    align-items: center;
    justify-content: center;
    padding: 32px;
}

.title {
    font-size: 26px;
    color: #e8eaf0;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    letter-spacing: 6px;
    margin-bottom: 8px;
}

.divider {
    width: 100%;
    height: 1px;
    background-color: #2e3550;
    margin-top: 8px;
    margin-bottom: 24px;
}

.card-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 20px;
}

.card {
    width: 230px;
    margin-left: 10px;
    margin-right: 10px;
    padding: 24px;
    background-color: #16181f;
    border-color: #2e3550;
    border-width: 1px;
    border-radius: 10px;
    align-items: center;
    transition-duration: 0.12s;
}

.card:hover {
    background-color: #1e2130;
    border-color: #4a5a8a;
}

.card-selected {
    background-color: #1a2040;
    border-color: #7a9fff;
    border-width: 2px;
}

.card-sprite {
    width: 96px;
    height: 96px;
    min-width: 96px;
    min-height: 96px;
    max-width: 96px;
    max-height: 96px;
    margin-bottom: 12px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
    flex-shrink: 0;
}

.card-name {
    font-size: 15px;
    color: #e8eaf0;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: upper-center;
    margin-bottom: 8px;
}

.card-desc {
    font-size: 12px;
    color: #a8b0c8;
    -unity-text-align: upper-center;
    white-space: normal;
    margin-bottom: 14px;
}

.card-passive {
    font-size: 10px;
    color: #5a6480;
    -unity-text-align: upper-center;
    white-space: normal;
    margin-top: 8px;
}

.info-bar {
    width: 100%;
    padding: 14px 24px;
    background-color: #16181f;
    border-color: #2e3550;
    border-width: 1px;
    border-radius: 6px;
    margin-bottom: 20px;
    align-items: center;
}

.info-text {
    font-size: 13px;
    color: #a8b0c8;
    letter-spacing: 1px;
    -unity-text-align: upper-center;
}

.button-row {
    flex-direction: row;
    justify-content: center;
    width: 100%;
}

.btn {
    width: 190px;
    height: 52px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: #16181f;
    border-color: #2e3550;
    border-width: 1px;
    border-radius: 4px;
    color: #a8b0c8;
    font-size: 13px;
    letter-spacing: 3px;
    transition-duration: 0.12s;
}

.btn:hover {
    background-color: #1e2130;
    border-color: #7a9fff;
    color: #e8eaf0;
}

.btn:active { scale: 0.98; }

.btn-primary {
    background-color: #1e2a50;
    border-color: #4a5a8a;
    color: #a8c4ff;
}

.btn-primary:hover {
    background-color: #263260;
    border-color: #7a9fff;
    color: #e8eaf0;
}

.card-abilities {
    flex-direction: column;
    margin-top: 10px;
    margin-bottom: 8px;
    align-items: center;
    width: 100%;
}

.card-abilities-title {
    font-size: 9px;
    color: #4a5a8a;
    letter-spacing: 3px;
    margin-bottom: 8px;
    -unity-font-style: bold;
}

.card-ability-slots {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.card-ability-slot {
    width: 40px;
    height: 40px;
    background-color: #0d0d0f;
    border-color: #2e3550;
    border-width: 1px;
    border-radius: 6px;
    margin-right: 5px;
    margin-bottom: 5px;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
}

.card-ability-slot:hover {
    border-color: #7a9fff;
}

.card-ability-slot-empty {
    border-color: #1a1d28;
    background-color: rgba(13, 13, 15, 0.5);
}

.card-ability-name {
    font-size: 7px;
    color: #5a6480;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 2px;
    max-width: 40px;
}

.ability-tooltip {
    position: absolute;
    background-color: #16181f;
    border-color: #7a9fff;
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 10px;
    display: none;
}

.ability-tooltip-text {
    font-size: 11px;
    color: #e8eaf0;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    white-space: normal;
}
