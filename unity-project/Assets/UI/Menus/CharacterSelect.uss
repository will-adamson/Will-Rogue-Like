.root {
    width: 100%;
    height: 100%;
    background-color: #080608;
    align-items: center;
    justify-content: center;
    padding: 32px;
}

.title {
    font-size: 28px;
    color: #d4c4b0;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    letter-spacing: 6px;
    margin-bottom: 8px;
}

.divider {
    width: 100%;
    height: 1px;
    background-color: #3a2a2a;
    margin-top: 8px;
    margin-bottom: 20px;
}

.card-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 16px;
}

.card {
    width: 220px;
    margin-left: 10px;
    margin-right: 10px;
    padding: 20px;
    background-color: #13100f;
    border-color: #3a2a2a;
    border-width: 1px;
    border-radius: 12px;
    align-items: center;
    transition-duration: 0.15s;
}

.card:hover {
    background-color: #1a1412;
    border-color: #6a4040;
}

.card-selected {
    background-color: #1a1412;
    border-color: #904040;
    border-width: 2px;
}

.card-sprite {
    width: 80px;
    height: 80px;
    margin-bottom: 10px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 8px;
}

.card-name {
    font-size: 16px;
    color: #d4c4b0;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: upper-center;
    margin-bottom: 10px;
}

.card-desc {
    font-size: 11px;
    color: #8a7a6a;
    -unity-text-align: upper-center;
    white-space: normal;
    margin-bottom: 14px;
}

.card-passive {
    font-size: 10px;
    color: #6a5a4a;
    -unity-text-align: upper-center;
    white-space: normal;
    margin-top: 8px;
}

.info-bar {
    width: 100%;
    padding: 12px 20px;
    background-color: #13100f;
    border-color: #3a2a2a;
    border-width: 1px;
    border-radius: 10px;
    margin-bottom: 16px;
    align-items: center;
}

.info-text {
    font-size: 12px;
    color: #8a7a6a;
    letter-spacing: 1px;
    -unity-text-align: upper-center;
}

.button-row {
    flex-direction: row;
    justify-content: center;
    width: 100%;
}

.btn {
    width: 180px;
    height: 48px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: #13100f;
    border-color: #3a2a2a;
    border-width: 1px;
    border-radius: 8px;
    color: #8a7a6a;
    font-size: 13px;
    letter-spacing: 3px;
    transition-duration: 0.15s;
}

.btn:hover {
    background-color: #1a1412;
    border-color: #904040;
    color: #d4c4b0;
}

.btn:active { scale: 0.98; }

.btn-primary {
    border-color: #6a4040;
    color: #d4c4b0;
    background-color: #2a1a1a;
}

.btn-primary:hover {
    background-color: #341e1e;
    border-color: #b05050;
}

.card-abilities {
    flex-direction: column;
    margin-top: 8px;
    margin-bottom: 8px;
    align-items: center;
}

.card-abilities-title {
    font-size: 8px;
    color: #6a4a4a;
    letter-spacing: 3px;
    margin-bottom: 6px;
}

.card-ability-slots {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.card-ability-slot {
    width: 36px;
    height: 36px;
    background-color: #0e0b0a;
    border-color: #3a2a2a;
    border-width: 1px;
    border-radius: 6px;
    margin-right: 4px;
    margin-bottom: 4px;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
}

.card-ability-slot-empty {
    border-color: #221818;
    background-color: rgba(14, 11, 10, 0.5);
}

.card-ability-name {
    font-size: 7px;
    color: #6a5a4a;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 2px;
    max-width: 36px;
}

.ability-tooltip {
    position: absolute;
    background-color: #13100f;
    border-color: #6a4040;
    border-width: 1px;
    border-radius: 4px;
    padding: 4px 8px;
    display: none;
}

.ability-tooltip-text {
    font-size: 10px;
    color: #d4c4b0;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    white-space: normal;
}