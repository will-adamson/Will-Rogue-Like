<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/HUD/HUD.uss?fileID=7433441132597879392&amp;guid=482582976e233444dbbb704836a904f7&amp;type=3#HUD"/>
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="top-left" class="top-left">
            <ui:VisualElement class="char-row">
                <ui:VisualElement name="char-sprite" class="char-sprite"/>
                <ui:VisualElement class="char-info">
                    <ui:Label name="label-class" text="DWARVEN FIGHTER" class="char-name"/>
                    <ui:Label name="label-type" text="Melee" class="char-type"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="panel-divider"/>
            <ui:VisualElement class="bar-row">
                <ui:Label text="HP" class="bar-icon bar-icon-hp"/>
                <ui:VisualElement class="bar-track">
                    <ui:VisualElement name="bar-hp-fill" class="bar-fill bar-fill-hp"/>
                </ui:VisualElement>
                <ui:Label name="label-hp" text="100/100" class="bar-num"/>
            </ui:VisualElement>
            <ui:VisualElement class="bar-row">
                <ui:Label text="STA" class="bar-icon bar-icon-sta"/>
                <ui:VisualElement class="bar-track">
                    <ui:VisualElement name="bar-sta-fill" class="bar-fill bar-fill-sta"/>
                </ui:VisualElement>
                <ui:Label name="label-sta" text="100/100" class="bar-num"/>
            </ui:VisualElement>
            <ui:VisualElement class="bar-row">
                <ui:Label text="EXP" class="bar-icon bar-icon-exp"/>
                <ui:VisualElement class="bar-track bar-track-exp">
                    <ui:VisualElement name="bar-exp-fill" class="bar-fill bar-fill-exp"/>
                </ui:VisualElement>
                <ui:Label name="label-level" text="Lvl 1" class="bar-num"/>
            </ui:VisualElement>
            <ui:VisualElement class="panel-divider"/>
            <ui:VisualElement class="stat-row">
                <ui:Label text="ATK" class="stat-key"/>
                <ui:Label name="label-atk" text="0" class="stat-val"/>
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label text="DEF" class="stat-key"/>
                <ui:Label name="label-def" text="0" class="stat-val"/>
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label text="SPD" class="stat-key"/>
                <ui:Label name="label-spd" text="0" class="stat-val"/>
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label text="CRIT" class="stat-key"/>
                <ui:Label name="label-crit" text="0%" class="stat-val"/>
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label text="CRIT DMG" class="stat-key"/>
                <ui:Label name="label-crit-mul" text="x1.5" class="stat-val"/>
            </ui:VisualElement>
            <ui:VisualElement class="panel-divider"/>
            <ui:Label text="CLASS TRAITS" class="section-title"/>
            <ui:VisualElement name="class-stats" class="class-stats"/>
        </ui:VisualElement>
        <ui:VisualElement name="minimap-container" class="minimap-container" style="height: 400px; width: 400px; left: auto; display: flex; visibility: visible; overflow: visible; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; top: 2px; right: 2px; border-top-left-radius: 200px; border-top-right-radius: 200px; border-bottom-right-radius: 200px; border-bottom-left-radius: 200px;">
            <ui:Label name="minimap-zone-label" text="MINIMAP PLACEHOLDER" enabled="true" class="minimap-zone-label" style="display: none;"/>
        </ui:VisualElement>
        <ui:VisualElement name="status-tray-container" class="status-tray-container">
            <ui:VisualElement name="buff-tray" class="status-tray"/>
            <ui:VisualElement name="debuff-tray" class="status-tray status-tray-debuff"/>
        </ui:VisualElement>
        <ui:VisualElement name="telegraph-container" class="telegraph-container">
            <ui:VisualElement class="telegraph-inner">
                <ui:Label name="telegraph-enemy-name" text="" class="telegraph-enemy-name"/>
                <ui:VisualElement class="panel-divider"/>
                <ui:VisualElement class="telegraph-attack-row">
                    <ui:VisualElement name="telegraph-danger-pip" class="telegraph-danger-pip"/>
                    <ui:Label name="telegraph-attack-name" text="" class="telegraph-attack-name"/>
                    <ui:Label name="telegraph-timer" text="" class="telegraph-timer"/>
                </ui:VisualElement>
                <ui:VisualElement class="telegraph-bar-track">
                    <ui:VisualElement name="telegraph-bar-fill" class="telegraph-bar-fill"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="log-container" class="log-container">
            <ui:ScrollView name="log-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="log-scroll">
                <ui:VisualElement name="log-content" class="log-content"/>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="quickslots-container" class="quickslots-container">
            <ui:VisualElement class="quickslots-row">
                <ui:VisualElement name="slot-0" class="quickslot">
                    <ui:Label text="1" class="quickslot-keybind"/>
                    <ui:VisualElement class="quickslot-icon"/>
                    <ui:Label text="" class="quickslot-count"/>
                    <ui:VisualElement class="quickslot-cooldown"/>
                </ui:VisualElement>
                <ui:VisualElement name="slot-1" class="quickslot">
                    <ui:Label text="2" class="quickslot-keybind"/>
                    <ui:VisualElement class="quickslot-icon"/>
                    <ui:Label text="" class="quickslot-count"/>
                    <ui:VisualElement class="quickslot-cooldown"/>
                </ui:VisualElement>
                <ui:VisualElement name="slot-2" class="quickslot">
                    <ui:Label text="3" class="quickslot-keybind"/>
                    <ui:VisualElement class="quickslot-icon"/>
                    <ui:Label text="" class="quickslot-count"/>
                    <ui:VisualElement class="quickslot-cooldown"/>
                </ui:VisualElement>
                <ui:VisualElement name="slot-3" class="quickslot">
                    <ui:Label text="4" class="quickslot-keybind"/>
                    <ui:VisualElement class="quickslot-icon"/>
                    <ui:Label text="" class="quickslot-count"/>
                    <ui:VisualElement class="quickslot-cooldown"/>
                </ui:VisualElement>
                <ui:VisualElement name="slot-4" class="quickslot quickslot-locked">
                    <ui:Label text="🔒" class="quickslot-lock-icon"/>
                </ui:VisualElement>
                <ui:VisualElement name="slot-5" class="quickslot quickslot-locked">
                    <ui:Label text="🔒" class="quickslot-lock-icon"/>
                </ui:VisualElement>
                <ui:VisualElement name="slot-6" class="quickslot quickslot-locked">
                    <ui:Label text="🔒" class="quickslot-lock-icon"/>
                </ui:VisualElement>
                <ui:VisualElement name="slot-7" class="quickslot quickslot-locked">
                    <ui:Label text="🔒" class="quickslot-lock-icon"/>
                </ui:VisualElement>
                <ui:VisualElement name="slot-8" class="quickslot quickslot-locked">
                    <ui:Label text="🔒" class="quickslot-lock-icon"/>
                </ui:VisualElement>
                <ui:VisualElement name="slot-9" class="quickslot quickslot-locked">
                    <ui:Label text="🔒" class="quickslot-lock-icon"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
