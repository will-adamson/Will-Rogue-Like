<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="HUD.uss" />
    <ui:VisualElement name="root" class="root">

        <ui:VisualElement name="top-left" class="top-left">
            <ui:VisualElement class="char-row">
                <ui:VisualElement name="char-sprite" class="char-sprite" />
                <ui:VisualElement class="char-info">
                    <ui:Label name="label-class" class="char-name" text="KNIGHT" />
                    <ui:Label name="label-type"  class="char-type"  text="Melee" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="panel-divider" />

            <ui:VisualElement class="bar-row">
                <ui:Label class="bar-icon bar-icon-hp" text="HP" />
                <ui:VisualElement class="bar-track">
                    <ui:VisualElement name="bar-hp-fill" class="bar-fill bar-fill-hp" />
                </ui:VisualElement>
                <ui:Label name="label-hp" class="bar-num" text="100/100" />
            </ui:VisualElement>

            <ui:VisualElement class="bar-row">
                <ui:Label class="bar-icon bar-icon-sta" text="STA" />
                <ui:VisualElement class="bar-track">
                    <ui:VisualElement name="bar-sta-fill" class="bar-fill bar-fill-sta" />
                </ui:VisualElement>
                <ui:Label name="label-sta" class="bar-num" text="100/100" />
            </ui:VisualElement>

            <ui:VisualElement class="bar-row">
                <ui:Label class="bar-icon bar-icon-exp" text="EXP" />
                <ui:VisualElement class="bar-track bar-track-exp">
                    <ui:VisualElement name="bar-exp-fill" class="bar-fill bar-fill-exp" />
                </ui:VisualElement>
                <ui:Label name="label-level" class="bar-num" text="Lvl 1" />
            </ui:VisualElement>

            <ui:VisualElement class="panel-divider" />

            <ui:VisualElement class="stat-row">
                <ui:Label class="stat-key" text="ATK" />
                <ui:Label name="label-atk" class="stat-val" text="0" />
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label class="stat-key" text="DEF" />
                <ui:Label name="label-def" class="stat-val" text="0" />
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label class="stat-key" text="SPD" />
                <ui:Label name="label-spd" class="stat-val" text="0" />
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label class="stat-key" text="CRIT" />
                <ui:Label name="label-crit" class="stat-val" text="0%" />
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label class="stat-key" text="CRIT DMG" />
                <ui:Label name="label-crit-mul" class="stat-val" text="x1.5" />
            </ui:VisualElement>

            <ui:VisualElement class="panel-divider" />

            <ui:Label class="section-title" text="CLASS TRAITS" />
            <ui:VisualElement name="class-stats" class="class-stats" />
        </ui:VisualElement>

        <!-- Minimap -->
        <ui:VisualElement name="minimap-container" class="minimap-container">
            <ui:Label name="minimap-zone-label" class="minimap-zone-label" text="MINIMAP PLACEHOLDER" />
        </ui:VisualElement>

        <!-- Status effect tray -->
        <ui:VisualElement name="status-tray-container" class="status-tray-container">
            <ui:VisualElement name="buff-tray"   class="status-tray" />
            <ui:VisualElement name="debuff-tray" class="status-tray status-tray-debuff" />
        </ui:VisualElement>

        <!-- Enemy telegraph -->
        <ui:VisualElement name="telegraph-container" class="telegraph-container">
            <ui:VisualElement class="telegraph-inner">
                <ui:Label name="telegraph-enemy-name" class="telegraph-enemy-name" text="" />
                <ui:VisualElement class="panel-divider" />
                <ui:VisualElement class="telegraph-attack-row">
                    <ui:VisualElement name="telegraph-danger-pip" class="telegraph-danger-pip" />
                    <ui:Label name="telegraph-attack-name" class="telegraph-attack-name" text="" />
                    <ui:Label name="telegraph-timer"       class="telegraph-timer"       text="" />
                </ui:VisualElement>
                <ui:VisualElement class="telegraph-bar-track">
                    <ui:VisualElement name="telegraph-bar-fill" class="telegraph-bar-fill" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Log feed -->
        <ui:VisualElement name="log-container" class="log-container">
            <ui:ScrollView name="log-scroll" class="log-scroll"
                vertical-scroller-visibility="Hidden"
                horizontal-scroller-visibility="Hidden">
                <ui:VisualElement name="log-content" class="log-content" />
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- Quick slots -->
        <ui:VisualElement name="quickslots-container" class="quickslots-container">
            <ui:VisualElement class="quickslots-row">
                <ui:VisualElement name="slot-0" class="quickslot">
                    <ui:Label class="quickslot-keybind" text="1" />
                    <ui:VisualElement class="quickslot-icon" />
                    <ui:Label class="quickslot-count" text="" />
                    <ui:VisualElement class="quickslot-cooldown" />
                </ui:VisualElement>
                <ui:VisualElement name="slot-1" class="quickslot">
                    <ui:Label class="quickslot-keybind" text="2" />
                    <ui:VisualElement class="quickslot-icon" />
                    <ui:Label class="quickslot-count" text="" />
                    <ui:VisualElement class="quickslot-cooldown" />
                </ui:VisualElement>
                <ui:VisualElement name="slot-2" class="quickslot">
                    <ui:Label class="quickslot-keybind" text="3" />
                    <ui:VisualElement class="quickslot-icon" />
                    <ui:Label class="quickslot-count" text="" />
                    <ui:VisualElement class="quickslot-cooldown" />
                </ui:VisualElement>
                <ui:VisualElement name="slot-3" class="quickslot">
                    <ui:Label class="quickslot-keybind" text="4" />
                    <ui:VisualElement class="quickslot-icon" />
                    <ui:Label class="quickslot-count" text="" />
                    <ui:VisualElement class="quickslot-cooldown" />
                </ui:VisualElement>
                <ui:VisualElement name="slot-4" class="quickslot quickslot-locked">
                    <ui:Label class="quickslot-lock-icon" text="🔒" />
                </ui:VisualElement>
                <ui:VisualElement name="slot-5" class="quickslot quickslot-locked">
                    <ui:Label class="quickslot-lock-icon" text="🔒" />
                </ui:VisualElement>
                <ui:VisualElement name="slot-6" class="quickslot quickslot-locked">
                    <ui:Label class="quickslot-lock-icon" text="🔒" />
                </ui:VisualElement>
                <ui:VisualElement name="slot-7" class="quickslot quickslot-locked">
                    <ui:Label class="quickslot-lock-icon" text="🔒" />
                </ui:VisualElement>
                <ui:VisualElement name="slot-8" class="quickslot quickslot-locked">
                    <ui:Label class="quickslot-lock-icon" text="🔒" />
                </ui:VisualElement>
                <ui:VisualElement name="slot-9" class="quickslot quickslot-locked">
                    <ui:Label class="quickslot-lock-icon" text="🔒" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>