.root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
}

/* ── Character Panel ─────────────────────────────────────────────────── */

.top-left {
    align-self: flex-start;
    flex-direction: column;
    margin: 8px;
    width: 220px;
    background-color: rgba(42, 45, 62, 0.96);
    border-color: #4a5070;
    border-width: 1px;
    padding: 12px;
}

.char-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.char-sprite {
    width: 38px;
    height: 38px;
    background-color: #1c1f2e;
    border-color: #4a5070;
    border-width: 1px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.char-info { flex-direction: column; }

.char-name {
    font-size: 13px;
    color: #f0f2ff;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.char-type {
    font-size: 10px;
    color: #8890b0;
    letter-spacing: 1px;
    margin-top: 2px;
}

/* ── Resource Bars ───────────────────────────────────────────────────── */

.bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.bar-icon {
    font-size: 10px;
    width: 26px;
    -unity-text-align: middle-left;
    margin-right: 6px;
    flex-shrink: 0;
    -unity-font-style: bold;
}

.bar-icon-hp  { color: #ff8080; }
.bar-icon-sta { color: #60d890; }
.bar-icon-exp { color: #f0c040; }

.bar-track {
    flex-grow: 1;
    height: 14px;
    background-color: #1c1f2e;
    border-color: #4a5070;
    border-width: 1px;
    overflow: hidden;
}

.bar-track-exp { height: 8px; }

.bar-fill { height: 100%; }

.bar-fill-hp  { background-color: #c84848; }
.bar-fill-sta { background-color: #48a868; }
.bar-fill-exp { background-color: #b08820; }

.bar-num {
    font-size: 10px;
    color: #c8cce0;
    width: 54px;
    -unity-text-align: middle-right;
    margin-left: 6px;
    flex-shrink: 0;
}

/* ── Panel Divider ───────────────────────────────────────────────────── */

.panel-divider {
    height: 1px;
    background-color: #4a5070;
    margin-top: 6px;
    margin-bottom: 8px;
}

/* ── Stats ───────────────────────────────────────────────────────────── */

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3px;
}

.stat-key {
    font-size: 10px;
    color: #8890b0;
    -unity-font-style: bold;
}

.stat-val {
    font-size: 11px;
    color: #c8cce0;
    -unity-text-align: middle-right;
}

.section-title {
    font-size: 9px;
    color: #7a8ab0;
    letter-spacing: 3px;
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.class-stats { flex-direction: column; }

.class-stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3px;
}

.class-stat-key {
    font-size: 10px;
    color: #7a8ab0;
}

.class-stat-val {
    font-size: 10px;
    color: #7eb4ff;
    -unity-text-align: middle-right;
}

/* ── Log Feed ────────────────────────────────────────────────────────── */

.log-container {
    position: absolute;
    bottom: 8px;
    left: 8px;
    width: 420px;
    height: 110px;
    background-color: rgba(42, 45, 62, 0.92);
    border-width: 1px;
    border-color: #4a5070;
    padding: 6px 10px;
    flex-shrink: 0;
}

.log-scroll  { width: 100%; height: 100%; }

.log-content {
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100%;
}

.log-line {
    font-size: 11px;
    color: #4a5070;
    white-space: normal;
    margin-bottom: 2px;
}

.log-line.log-line-latest            { color: #c8cce0; }
.log-line.log-line-damage            { color: #d07070; }
.log-line.log-line-good              { color: #60b878; }
.log-line.log-line-gold              { color: #d0a830; }
.log-line.log-line-system            { color: #7a8ab0; -unity-font-style: italic; }

.log-line.log-line-latest.log-line-damage { color: #ff9090; }
.log-line.log-line-latest.log-line-good   { color: #80d898; }
.log-line.log-line-latest.log-line-gold   { color: #f0c040; }
.log-line.log-line-latest.log-line-system { color: #a0aad0; -unity-font-style: italic; }

/* ── Minimap ─────────────────────────────────────────────────────────── */

.minimap-container {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 148px;
    height: 148px;
    border-radius: 74px;
    border-width: 1px;
    border-color: #4a5070;
    background-color: rgba(42, 45, 62, 0.96);
    align-items: center;
    justify-content: center;
}

.minimap-zone-label {
    font-size: 8px;
    color: #7a8ab0;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

/* ── Quick Slots ─────────────────────────────────────────────────────── */

.quickslots-container {
    position: absolute;
    bottom: 8px;
    left: 0;
    right: 0;
    align-items: center;
}

.quickslots-row {
    flex-direction: row;
    align-items: center;
    background-color: rgba(42, 45, 62, 0.96);
    border-color: #4a5070;
    border-width: 1px;
    padding: 6px;
}

.quickslot {
    width: 52px;
    height: 52px;
    background-color: #1c1f2e;
    border-color: #4a5070;
    border-width: 1px;
    margin-left: 3px;
    margin-right: 3px;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
}

.quickslot-selected {
    border-color: #7eb4ff;
    border-width: 2px;
}

.quickslot-keybind {
    position: absolute;
    top: 2px;
    left: 3px;
    font-size: 8px;
    color: #7a8ab0;
    -unity-font-style: bold;
}

.quickslot-icon {
    position: absolute;
    top: 6px;
    left: 6px;
    right: 6px;
    bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.quickslot-count {
    position: absolute;
    bottom: 2px;
    right: 3px;
    font-size: 8px;
    color: #c8cce0;
    -unity-font-style: bold;
    -unity-text-align: lower-right;
}

.quickslot-cooldown {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 0;
    background-color: rgba(0, 0, 0, 0.65);
}

.quickslot-locked {
    background-color: rgba(28, 31, 46, 0.6);
    border-color: #363a52;
}

.quickslot-lock-icon {
    font-size: 14px;
    color: #4a5070;
    -unity-text-align: middle-center;
}

/* ── Enemy Telegraph ─────────────────────────────────────────────────── */

.telegraph-container {
    position: absolute;
    top: 8px;
    left: 0;
    right: 0;
    align-items: center;
    display: none;
}

.telegraph-container.telegraph-visible { display: flex; }

.telegraph-inner {
    flex-direction: column;
    background-color: rgba(42, 45, 62, 0.96);
    border-color: #4a5070;
    border-width: 1px;
    padding: 10px 16px;
    min-width: 260px;
    max-width: 380px;
    align-items: stretch;
}

.telegraph-enemy-name {
    font-size: 9px;
    color: #8890b0;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.telegraph-attack-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.telegraph-danger-pip {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 8px;
    flex-shrink: 0;
}

.telegraph-danger-low    { background-color: #60c888; }
.telegraph-danger-medium { background-color: #f0c040; }
.telegraph-danger-high   { background-color: #e06060; }

.telegraph-attack-name {
    font-size: 12px;
    color: #f0f2ff;
    -unity-font-style: bold;
    flex-grow: 1;
}

.telegraph-timer {
    font-size: 11px;
    color: #c8cce0;
    -unity-text-align: middle-right;
    margin-left: 10px;
    flex-shrink: 0;
}

.telegraph-bar-track {
    height: 4px;
    background-color: #1c1f2e;
    border-color: #4a5070;
    border-width: 1px;
    overflow: hidden;
}

.telegraph-bar-fill {
    height: 100%;
    width: 100%;
    background-color: #7a8ab0;
}

.telegraph-bar-fill.telegraph-danger-low    { background-color: #48a868; }
.telegraph-bar-fill.telegraph-danger-medium { background-color: #b08820; }
.telegraph-bar-fill.telegraph-danger-high   { background-color: #c84848; }

/* ── Status Tray ─────────────────────────────────────────────────────── */

.status-tray-container {
    position: absolute;
    top: 164px;
    right: 8px;
    flex-direction: column;
    align-items: flex-end;
}

.status-tray {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    max-width: 280px;
    margin-bottom: 4px;
}

.tray-slot {
    width: 56px;
    height: 56px;
    background-color: rgba(42, 45, 62, 0.96);
    border-color: #4a5070;
    border-width: 1px;
    margin-left: 4px;
    margin-bottom: 4px;
    position: relative;
    overflow: hidden;
    align-items: center;
    justify-content: center;
}

.tray-slot-debuff { border-color: #905050; }

.tray-icon {
    position: absolute;
    top: 4px;
    left: 4px;
    right: 4px;
    bottom: 18px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: #363a52;
}

.tray-timer {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 18px;
    font-size: 11px;
    color: #f0f2ff;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.70);
}

.tray-stacks {
    position: absolute;
    top: 3px;
    right: 4px;
    font-size: 11px;
    color: #f0c040;
    -unity-font-style: bold;
    -unity-text-align: upper-right;
}
